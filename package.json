{
	"name": "yard-bridge",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.3",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync",
		"check": "bun run check:frontend && bun run check:backend && bun run check:worker",
		"check:toolchain": "vp check",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --strategy url baseLocale",
		"check:frontend": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:backend": "tsc --noEmit -p src/convex/tsconfig.json",
		"check:worker": "svelte-kit sync && tsc --noEmit -p src/service-worker/tsconfig.json",
		"check:watch": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp lint . && bun run lint:eslint",
		"lint:eslint": "eslint . --max-warnings 0",
		"format:check": "vp fmt --check .",
		"format": "vp fmt .",
		"test:unit": "vp test run",
		"test:unit:watch": "vp test",
		"test": "bun run test:unit && bun run test:e2e",
		"test:install": "playwright install chromium firefox webkit",
		"test:e2e": "bun run build && playwright test",
		"quality": "bun run check:toolchain && bun run lint:eslint && bun run check && bun run test"
	},
	"devDependencies": {
		"@edge-runtime/vm": "^5.0.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/svelte": "^1.1.5",
		"@inlang/paraglide-js": "^2.18.2",
		"@internationalized/date": "^3.12.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "5.0.3",
		"bits-ui": "^2.18.0",
		"cn": "^0.3.0",
		"convex-test": "^0.0.60",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jose": "6.2.12",
		"playwright": "^1.60.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
		"vite-plus": "1.1.0",
		"vitest": "5.0.3",
		"vitest-browser-svelte": "3.1.0"
	},
	"dependencies": {
		"@convex-dev/auth": "0.0.96",
		"@mmailaender/convex-auth-svelte": "0.1.4",
		"@oslojs/crypto": "1.0.1",
		"convex": "^1.46.0",
		"convex-svelte": "^0.14.0",
		"mode-watcher": "^1.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
		"vitest": "5.0.3"
	},
	"engines": {
		"node": "^24.11.0"
	}
}
